# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps (Distance Matrix + Places Autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Viber Bot/Public Account REST API
# https://developers.viber.com/docs/api/rest-bot-api/
VIBER_AUTH_TOKEN=
VIBER_GROUP_ID=

# PayMongo (https://dashboard.paymongo.com/developers)
PAYMONGO_SECRET_KEY=
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Base URL of the deployed app, used for payment redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
